# Copy file này thành .env rồi sửa giá trị nếu cần.
#   cp .env.example .env
# docker compose tự đọc .env ở thư mục chứa docker-compose.yml.

# ─────────────────────── Credentials ───────────────────────

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# JWT secret — đổi cho production. Phải base64-encoded ≥ 32 bytes.
JWT_ACCESS_SECRET=dGFza2Zsb3dfYWNjZXNzX3Rva2VuX3NlY3JldF9rZXlfZGV2X29ubHk=
JWT_REFRESH_SECRET=dGFza2Zsb3dfcmVmcmVzaF90b2tlbl9zZWNyZXRfa2V5X2Rldl9vbmx5
JWT_RESET_SECRET=dGFza2Zsb3dfcmVzZXRfcGFzc3dvcmRfc2VjcmV0X2Rldl9vbmx5

# ─────────────────────── Port mapping ra host ───────────────────────

POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
RABBITMQ_HOST_PORT=5672
RABBITMQ_MGMT_PORT=15672
MINIO_HOST_PORT=9000
MINIO_CONSOLE_PORT=9001
EUREKA_HOST_PORT=8761
CONFIG_HOST_PORT=8888
GATEWAY_HOST_PORT=8080
FE_HOST_PORT=5173

# ─────────────────────── Public URL FE build vào bundle ───────────────────────
# Đây là URL browser dùng để gọi API qua Gateway (đã expose ra host).
# Khi deploy ra domain khác, đổi cả 2 dòng dưới.

PUBLIC_API_URL=http://localhost:8080/api/v1
PUBLIC_WS_URL=http://localhost:8080/ws/notifications

# ─────────────────────── MinIO buckets ───────────────────────

MINIO_ATTACHMENT_BUCKET=taskflow-attachments
MINIO_AVATAR_BUCKET=taskflow-avatars
